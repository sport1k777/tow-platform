NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://tow:tow@localhost:5433/tow_platform
JWT_SECRET=change-me-in-development-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_WINDOW_SECONDS=600
OTP_REQUEST_MAX=3
AUTH_OTP_MODE=mock
SMS_PROVIDER=dev
GEO_PROVIDER=dev
PRICING_PROVIDER=database
PAYMENT_PROVIDER=mock
# Development-only. Auto-accepts the first matched fixture driver when NODE_ENV=development.
# MATCHING_DEV_AUTO_ACCEPT=true
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
GEO_USER_AGENT=tow-platform/0.1 (phase-4-geo)
NOTIFICATION_PROVIDER=dev
CORS_ORIGINS=*
QUOTE_TTL_SECONDS=600
ORDER_SEARCH_TTL_SECONDS=900
OFFER_TTL_SECONDS=60
VERIFICATION_MODE=manual
VERIFICATION_PROVIDER=none
UPLOAD_DIR=uploads
MAX_AVATAR_BYTES=8388608
MAX_DOCUMENT_BYTES=12582912
